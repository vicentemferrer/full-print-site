---
import Layout from '../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

// SSR por defecto
let error = "";

// Secret key for JWT. In a real app, use an environment variable (e.g. process.env.JWT_SECRET)
const JWT_SECRET = process.env.JWT_SECRET || "super-secret-key-for-dev";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const username = data.get("username");
    const password = data.get("password");

    // Lógica básica de autenticación
    if (username === "admin" && password === "admin") {
      // Create a secure token instead of a simple boolean
      const token = jwt.sign({ user: username }, JWT_SECRET, { expiresIn: '1h' });
      Astro.cookies.set("admin_session", token, { path: "/", httpOnly: true, secure: process.env.NODE_ENV === 'production' });
      return Astro.redirect("/admin");
    } else {
      error = "Usuario o contraseña incorrectos.";
    }
  } catch (e) {
    if (e instanceof Error) {
      error = e.message;
    }
  }
}
---

<Layout title="Login Administrador">
  <main>
    <h1>Login de Administrador</h1>
    {error && <p style="color: red;">{error}</p>}
    <form method="POST">
      <div>
        <label>Usuario: <input type="text" name="username" required /></label>
      </div>
      <div>
        <label>Contraseña: <input type="password" name="password" required /></label>
      </div>
      <button type="submit">Entrar</button>
    </form>
  </main>
</Layout>
