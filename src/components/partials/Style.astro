<style is:global>
  :root {
    /* Full Print Color Palette - Modernized */
    --dark-primary-color: #27272a;
    --dark-accent-color: #18181b;
    --dark-shadow-color: rgba(9, 9, 11, 0.5);

    --accent1-light-color: #f472b6;
    --accent1-main-color: #ec4899;
    --accent1-dark-color: #db2777;
    --accent2-light-color: #fde047;
    --accent2-main-color: #eab308;
    --accent2-dark-color: #ca8a04;
    --accent3-light-color: #38bdf8;
    --accent3-main-color: #0ea5e9;
    --accent3-dark-color: #0284c7;
    --accent4-light-color: #fb923c;
    --accent4-main-color: #f97316;
    --accent4-dark-color: #ea580c;

    --gold1-color: rgba(250, 204, 21, 1);
    --gold2-color: rgba(234, 179, 8, 1);
    --gold3-color: rgba(202, 138, 4, 1);

    --text-on-color: white;

    /* Backgrounds */
    --main-background-color: var(--dark-primary-color);
    --shadow-background-color: var(--dark-shadow-color);
    --social-background-color: var(--dark-primary-color);

    --form-background-color: var(--dark-primary-color);
    --input-background-color: var(--dark-accent-color);

    /* Links & Buttons */
    --link-color: var(--text-on-color);
    --button-hover-color: transparent;

    --fb-color: steelblue;
    --ig-color: #dd2a7b;
    --wp-color: #25d366;

    --link-ft-hover-color: var(--accent1-main-color);
    --link-help-hover-color: var(--accent1-main-color);

    --link-shadow-color: var(--dark-accent-color);

    /* Nav links Gradients */
    --home-gradient1-color: var(--accent2-dark-color);
    --home-gradient2-color: var(--accent2-main-color);
    --home-gradient3-color: var(--accent2-light-color);

    --services-gradient1-color: var(--accent3-dark-color);
    --services-gradient2-color: var(--accent3-main-color);
    --services-gradient3-color: var(--accent3-light-color);

    --products-gradient1-color: var(--accent1-dark-color);
    --products-gradient2-color: var(--accent1-main-color);
    --products-gradient3-color: var(--accent1-light-color);

    --contact-gradient1-color: var(--accent4-dark-color);
    --contact-gradient2-color: var(--accent4-main-color);
    --contact-gradient3-color: var(--accent4-light-color);

    /* Button Gradients */
    --premium-gradient1-color: var(--gold3-color);
    --premium-gradient2-color: var(--gold2-color);
    --premium-gradient3-color: var(--gold1-color);

    --dark-gradient1-color: var(--dark-accent-color);
    --dark-gradient2-color: var(--dark-primary-color);

    --base-gradient1-color: var(--accent1-dark-color);
    --base-gradient2-color: var(--accent1-main-color);
    --base-gradient3-color: var(--accent1-light-color);

    --secondary-gradient1-color: var(--accent3-dark-color);
    --secondary-gradient2-color: var(--accent3-light-color);

    /* Carousel Arrows Gradients */
    --carousel-gradient1-color: var(--dark-accent-color);
    --carousel-gradient2-color: transparent;
  }

  *,
  *::before,
  *::after {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }

  html {
    font-family: system-ui, sans-serif;
    background: #13151a;
    background-size: 224px;
  }

  body {
    width: 100%;
    min-height: 100vh;

    display: flex;
    flex-direction: column;

    color: var(--text-on-color);
  }

  header,
  main,
  footer {
    width: 100%;
  }

  main {
    flex-grow: 1;

    display: grid;
    grid-template-columns: auto 1fr auto;
  }

  a,
  #menu,
  nav summary {
    color: var(--link-color);
    text-decoration: none;
  }

  .action {
    font-weight: 500;

    text-align: center;
    text-decoration: none;

    padding: 1rem 2rem;

    border: 2px solid transparent;
    border-radius: 5rem;
    transition: all 0.3s ease;
    cursor: pointer;

    color: var(--link-color);

    &.premium {
      background-color: var(--accent2-main-color);
      color: var(--dark-primary-color);
      border-color: var(--accent2-main-color);
      font-weight: 600;

      &:hover {
        background-color: var(--accent2-light-color);
        border-color: var(--accent2-light-color);
        /* box-shadow: 0 4px 14px 0 rgba(234, 179, 8, 0.39); */
        transform: translateY(-2px);
      }
    }

    &.base {
      background-color: var(--accent1-main-color);
      color: white;
      border-color: var(--accent1-main-color);

      &:hover {
        background-color: var(--accent1-light-color);
        border-color: var(--accent1-light-color);
        /* box-shadow: 0 4px 14px 0 rgba(236, 72, 153, 0.39); */
        transform: translateY(-2px);
      }
    }

    &.secondary {
      background-color: transparent;
      color: var(--accent3-main-color);
      border-color: var(--accent3-main-color);

      &:hover {
        background-color: var(--accent3-main-color);
        color: white;
        /* box-shadow: 0 4px 14px 0 rgba(14, 165, 233, 0.39); */
        transform: translateY(-2px);
      }
    }

    & i {
      font-size: small;
      margin-right: 0.25rem;
    }
  }

  @media (767px < width) {
    .text-badge {
      padding: 0.5rem 1rem;

      background-color: var(--social-background-color);
      border: 1px solid white;
      border-radius: 2rem;
    }
  }
</style>
